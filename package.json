{
  "name": "ay-toys-dashboard",
  "productName": "CAS World Wide",
  "private": true,
  "version": "1.16.0",
  "description": "CAS World Wide — QuickBooks-style wholesale accounting. Works offline, syncs with Google Sheets.",
  "author": "CAS World Wide",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-config.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "release": "vite build && electron-builder --win nsis portable --publish never && node electron/finish-release.cjs",
    "app": "vite build && electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "43.7.7",
    "electron-builder": "26.16.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "com.aytoys.accounting",
    "productName": "CAS World Wide",
    "copyright": "CAS World Wide",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CAS World Wide",
      "uninstallDisplayName": "CAS World Wide",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CAS World Wide Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "CAS World Wide ${version} Portable.${ext}"
    }
  }
}
